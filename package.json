{
  "name": "@dougefresh/pi-azure-foundry",
  "version": "1.2.0",
  "description": "Pi extension for Azure AI Foundry — discovers deployments and registers models",
  "type": "module",
  "main": "./dist/index.js",
  "exports": {
    ".": "./dist/index.js"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/dougefresher/pi-azure-foundry.git"
  },
  "keywords": [
    "pi",
    "pi-package",
    "azure",
    "foundry",
    "ai",
    "provider"
  ],
  "author": "dougefresh",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "bundledDependencies": [
    "@azure/identity"
  ],
  "pi": {
    "extensions": [
      "./dist/index.js"
    ]
  },
  "scripts": {
    "test": "bun test",
    "smoke": "bun test ./smoke/live.test.ts",
    "smoke-test": "bun test --concurrent ./smoke/live.test.ts",
    "format": "biome check --write .",
    "check": "biome check --error-on-warnings . && tsc --noEmit",
    "changeset": "changeset",
    "changeset:version": "changeset version",
    "build": "tsc",
    "prepare": "npm run build",
    "dev": "tsc --watch",
    "clean": "rm -rf dist",
    "prebuild": "npm run clean",
    "type-check": "tsc --noEmit"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.6",
    "@changesets/cli": "^2.31.1",
    "@earendil-works/pi-ai": "^0.83.0",
    "@earendil-works/pi-coding-agent": "^0.83.0",
    "@types/node": "^26.1.2",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@earendil-works/pi-ai": "*",
    "@earendil-works/pi-coding-agent": "*"
  },
  "peerDependenciesMeta": {
    "@earendil-works/pi-ai": {
      "optional": true
    },
    "@earendil-works/pi-coding-agent": {
      "optional": true
    }
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "dependencies": {
    "@azure/identity": "^4.13.1"
  },
  "bundleDependencies": [
    "@azure/identity"
  ]
}
